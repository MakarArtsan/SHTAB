# Пример окружения. Скопируйте в .env и при необходимости поправьте.
# Значения ниже рассчитаны на локальный запуск через docker compose.
# Реальные секреты в репозиторий не коммитим.

# --- общее ---
APP_ENV=local                       # local | staging | production
APP_DEBUG=true
API_PORT=8000
WEB_PORT=5173
DEFAULT_TZ=Europe/Moscow            # часовой пояс по умолчанию, пока у узла не задан свой

# --- PostgreSQL ---
POSTGRES_USER=shtab
POSTGRES_PASSWORD=shtab_local_password
POSTGRES_DB=shtab
POSTGRES_PORT=5432
# Хост db — имя сервиса в docker compose. Для запуска вне докера поставьте localhost.
DATABASE_URL=postgresql+asyncpg://shtab:shtab_local_password@db:5432/shtab

# --- Redis: pub/sub для WebSocket, кэш, очереди ARQ, rate limit ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- S3-совместимое хранилище (локально MinIO) ---
S3_ENDPOINT=http://minio:9000       # адрес для сервера
S3_PUBLIC_ENDPOINT=http://localhost:9000  # адрес в presigned-ссылках для браузера
S3_ACCESS_KEY=shtab_minio
S3_SECRET_KEY=shtab_minio_password
S3_BUCKET=shtab-media
S3_REGION=ru-central1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- токены и сессии (этап «Вход и учётные записи») ---
JWT_SECRET=change_me_in_production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- фронтенд ---
VITE_API_BASE_URL=http://localhost:8000

# --- внешние провайдеры ---
# Все за интерфейсами в api/app/services/providers/. Значение stub — заглушка,
# которая пишет в лог вместо реальной отправки. Так работает локальная разработка.
SMS_PROVIDER=stub                   # stub | smsru
SMS_API_KEY=
LLM_PROVIDER=stub                   # stub | gigachat
LLM_API_KEY=
GEOCODER_PROVIDER=stub              # stub | yandex
GEOCODER_API_KEY=

# --- Web Push (этап «Уведомления») ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:shtab@example.org

# --- мониторинг ---
SENTRY_DSN=

# --- продакшн: используется только infra/docker-compose.prod.yml ---
DOMAIN=shtab.example.org
ACME_EMAIL=admin@example.org
